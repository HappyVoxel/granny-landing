{
  "name": "granny-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:watch": "graphile-migrate watch",
    "db:migrate": "graphile-migrate migrate",
    "db:commit": "graphile-migrate commit",
    "db:reset": "graphile-migrate reset",
    "db:codegen": "kysely-codegen --dialect postgres --exclude-pattern graphile_migrate.* --out-file lib/db-types.ts",
    "auth:generate": "pnpm dlx @better-auth/cli@latest generate --yes --output migrations/current.sql",
    "docker": "docker compose -f docker/compose.dev.yml --env-file .env up -d --wait",
    "docker:stop": "docker compose -f docker/compose.dev.yml --env-file .env stop",
    "docker:down": "docker compose -f docker/compose.dev.yml --env-file .env down",
    "docker:ps": "docker compose -f docker/compose.dev.yml --env-file .env ps -a",
    "docker:logs": "docker compose -f docker/compose.dev.yml --env-file .env logs -f"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/react": "^4.0.129",
    "@base-ui/react": "^1.8.0",
    "@better-auth/api-key": "^1.7.7",
    "@better-fetch/fetch": "^1.3.2",
    "@fastbackr/core": "0.0.5",
    "@fastbackr/react": "0.0.5",
    "@gsap/react": "^2.1.2",
    "@shadcn/react": "^0.3.1",
    "ai": "^7.0.126",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.5.0",
    "jotai": "^3.0.1",
    "kysely": "^0.29.6",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "graphile-migrate": "^1.4.1",
    "kysely-codegen": "^0.20.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  }
}
